{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["services/scanner/**"]
  },
  "deploy": {
    "startCommand": "python -m scanner.main",
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false
  }
}
