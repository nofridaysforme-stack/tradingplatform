# Copy to .env for local development. Never commit real values.
# Every variable from docs/specs/16-deployment-and-operations.md.
# Service column: web, scanner, or both.

# both: Postgres connection (Railway reference variable in staging and production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal?sslmode=disable
# both: public URL of the portal
APP_URL=http://localhost:3000
# web: optional, defaults to APP_URL. Sign-in links use this address.
# AUTH_URL=
# web: tests and local development only. Writes sign-in links to <folder>/<email>.json
# instead of emailing them. Never set it in staging or production.
# AUTH_TEST_MAILBOX=
# web: tests only. Raises the sign-in limit of 20 links per IP per hour. Never set it in
# staging or production.
# AUTH_IP_LIMIT=
# web: Auth.js secret, random 32 bytes (openssl rand -base64 32)
AUTH_SECRET=
# both: Resend API key for magic links and email alerts
RESEND_API_KEY=
# both: verified sender address
EMAIL_FROM="Alerts <alerts@example.com>"
# scanner: OANDA v20 API token (never sent to the browser)
OANDA_API_TOKEN=
# scanner: OANDA account id
OANDA_ACCOUNT_ID=
# scanner: practice or live
OANDA_ENV=practice
# scanner: Massive (formerly Polygon.io) API key (never sent to the browser)
MASSIVE_API_KEY=
# both: web push public key
VAPID_PUBLIC_KEY=
# scanner: web push private key
VAPID_PRIVATE_KEY=
# scanner: web push contact
VAPID_SUBJECT=mailto:ops@example.com
# both: Telegram bot token
TELEGRAM_BOT_TOKEN=
# web: Telegram bot username, without the @
TELEGRAM_BOT_USERNAME=
# web: secret checked on incoming Telegram webhook calls
TELEGRAM_WEBHOOK_SECRET=
# scanner: where health alerts go
OPS_ALERT_EMAIL=
# web: first admin email, used once by the seed
SEED_ADMIN_EMAIL=
# both: debug, info, warning, error
LOG_LEVEL=info
